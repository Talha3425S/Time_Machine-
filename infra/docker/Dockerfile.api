FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/

# Install dependencies
RUN npm install

# Copy source files
COPY apps/api ./apps/api

# Build the application
RUN cd apps/api && npm run build

# Expose port
EXPOSE 3001

# Start the application
CMD ["sh", "-c", "cd apps/api && npm run start:dev"]
