query: SELECT "ns"."nspname" AS "table_schema", "t"."relname" AS "table_name", "i"."relname" AS "constraint_name", "a"."attname" AS "column_name", CASE "ix"."indisunique" WHEN 't' THEN 'TRUE' ELSE'FALSE' END AS "is_unique", pg_get_expr("ix"."indpred", "ix"."indrelid") AS "condition", "types"."typname" AS "type_name", "am"."amname" AS "index_type" FROM "pg_class" "t" INNER JOIN "pg_index" "ix" ON "ix"."indrelid" = "t"."oid" INNER JOIN "pg_attribute" "a" ON "a"."attrelid" = "t"."oid"  AND "a"."attnum" = ANY ("ix"."indkey") INNER JOIN "pg_namespace" "ns" ON "ns"."oid" = "t"."relnamespace" INNER JOIN "pg_class" "i" ON "i"."oid" = "ix"."indexrelid" INNER JOIN "pg_type" "types" ON "types"."oid" = "a"."atttypid" INNER JOIN "pg_am" "am" ON "i"."relam" = "am"."oid" LEFT JOIN "pg_constraint" "cnst" ON "cnst"."conname" = "i"."relname" WHERE "t"."relkind" IN ('r', 'p') AND "cnst"."contype" IS NULL AND (("ns"."nspname" = 'public' AND "t"."relname" = 'organizations') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'projects') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'experiments') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'users') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'organization_members') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'incidents') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'hypotheses') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'agent_states') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'state_manifests') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'evidence_records') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'sandbox_executions') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'proof_reports') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'baselines') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'test_runs') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'state_graphs') OR ("ns"."nspname" = 'public' AND "t"."relname" = 'state_graph_nodes') OR ("ns"."nspname" = 'public' AND "t".